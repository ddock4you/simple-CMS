{
  "name": "@simple-cms/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "dev:https": "next dev --turbopack --experimental-https --port 3000",
    "build": "next build",
    "build:demo": "pnpm bundle-storybooks && next build",
    "bundle-storybooks": "node scripts/bundle-storybooks.mjs",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@krds-ui/tailwindcss-plugin": "^0.6.0",
    "@simple-cms/db": "workspace:*",
    "@simple-cms/editor": "workspace:*",
    "@simple-cms/types": "workspace:*",
    "@vercel/speed-insights": "^1.2.0",
    "isomorphic-dompurify": "^3.8.0",
    "krds-react": "^1.1.0",
    "krds-uiux": "^1.1.0",
    "lucide-react": "^1.8.0",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "swiper": "^12.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@simple-cms/config": "workspace:*",
    "@storybook/addon-vitest": "^10",
    "@storybook/nextjs-vite": "^10",
    "@storybook/react": "^10",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.28.0",
    "postcss": "^8.5.0",
    "storybook": "^10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  }
