# Database
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/simple_cms

# Docker self-host (Stage 8a) — docker compose가 db 서비스 생성 시 참조
# 미설정 시 compose 기본값 사용. DATABASE_URL의 user/password/db와 일치시킬 것
# POSTGRES_USER=cms_user
# POSTGRES_PASSWORD=cms_password
# POSTGRES_DB=simple_cms

# Auth (커스텀 세션)
SESSION_SECRET=your-secret-here

# 사용자 피드백 — 익명 IP 해싱 salt (운영 배포 전 반드시 강한 랜덤 값으로 교체)
# rotation 시 기존 24h rate limit 윈도우는 초기화됨
FEEDBACK_IP_SALT=replace-me-with-strong-random-hex

# Web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin seed (development/first deploy)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme123

# Media upload storage provider: local (default) | supabase
STORAGE_PROVIDER=local

# Optional: override local storage target (absolute path of web public dir)
# LOCAL_STORAGE_PUBLIC_DIR=/absolute/path/to/apps/web/public
# Docker 운영 시: LOCAL_STORAGE_PUBLIC_DIR=/app/apps/web/public (docker-compose.yml 자동 설정)

# Supabase Storage (only when STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# SUPABASE_STORAGE_BUCKET=uploads

# admin이 preview URL 생성 시 사용하는 web URL (미설정 시 NEXT_PUBLIC_SITE_URL 폴백)
# WEB_BASE_URL=https://example.com

# Supabase Prisma migrate 호환 (Supabase pooler + migrate deploy 사용 시)
# DIRECT_URL=postgresql://...

# 시연 모드 (Vercel 배포 시에만 true, 운영 self-host는 미설정)
# DEMO_MODE=true
# NEXT_PUBLIC_ADMIN_REWRITE_URL=https://admin.example.vercel.app  (DEMO_MODE=true 시 web이 admin 프록시)
# CRON_SECRET=your-cron-secret-here  (Vercel cron / keepalive 인증용)
