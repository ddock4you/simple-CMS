# Database
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/simple_cms

# Auth (커스텀 세션)
SESSION_SECRET=your-secret-here

# 사용자 피드백 — 익명 IP 해싱 salt (운영 배포 전 반드시 강한 랜덤 값으로 교체)
# rotation 시 기존 24h rate limit 윈도우는 초기화됨
FEEDBACK_IP_SALT=replace-me-with-strong-random-hex

# Web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin seed (development/first deploy)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme123

# Media upload storage provider: local (default) | supabase
STORAGE_PROVIDER=local

# Optional: override local storage target (absolute path of web public dir)
# LOCAL_STORAGE_PUBLIC_DIR=/absolute/path/to/apps/web/public

# Supabase Storage (only when STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# SUPABASE_STORAGE_BUCKET=uploads
