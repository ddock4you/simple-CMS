  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/client-runtime-utils": "^7.7.0",
    "@supabase/supabase-js": "^2.103.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "sharp": "^0.34.5",
